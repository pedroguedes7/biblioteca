
{% extends 'base.html.twig' %}

{% block title %}Relatório de livros por autor | Biblioteca{% endblock %}

{% block body %}
<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Relatório de Livros - Autores</h1>

        <a href="{{ path('app_livro_index') }}" class="btn btn-secondary">
            Voltar aos livros
        </a>
    </div>

    {% if autores is empty %}
        <div class="alert alert-info">
            Nenhum livro cadastrado para gerar o relatório.
        </div>
    {% else %}

        {% for autor in autores %}
            <div class="card shadow-sm mb-4">

                <div class="card-header bg-dark text-white">
                    <h2 class="h5 mb-0">
                        {{ autor.nome }}
                    </h2>
                </div>

                <div class="card-body">

                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Título</th>
                                    <th>Editora</th>
                                    <th>Edição</th>
                                    <th>Ano de publicação</th>
                                    <th class="text-end">Valor</th>
                                </tr>
                            </thead>

                            <tbody>
                                {% for livro in autor.livros %}
                                    <tr>
                                        <td>{{ livro.livro_id }}</td>
                                        <td>{{ livro.titulo }}</td>
                                        <td>{{ livro.editora }}</td>
                                        <td>{{ livro.edicao }}</td>
                                        <td>{{ livro.ano_publicacao }}</td>
                                        <td class="text-end">
                                            R$ {{ livro.valor|number_format(2, ',', '.') }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>

                        </table>
                    </div>

                    <div class="text-muted small mt-3">
                        Total de livros: {{ autor.livros|length }}
                    </div>

                </div>
            </div>
        {% endfor %}

        <div class="text-end fw-bold mb-4">
            Total de autores: {{ autores|length }}
        </div>

    {% endif %}

</div>
{% endblock %}
