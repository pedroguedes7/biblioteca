
{% extends 'base.html.twig' %}

{% block title %}Assuntos | Biblioteca{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Assuntos</h1>

        <a href="{{ path('app_assunto_novo') }}" class="btn btn-primary">
            Novo assunto
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            {% if assuntos is empty %}
                <p class="text-muted mb-0">
                    Nenhum assunto cadastrado.
                </p>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Descrição</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for assunto in assuntos %}
                                <tr>
                                    <td>{{ assunto.codAs }}</td>
                                    <td>{{ assunto.descricao }}</td>
                                    <td class="text-end">
                                        <a
                                            href="{{ path('app_assunto_editar', {id: assunto.codAs}) }}"
                                            class="btn btn-sm btn-outline-primary"
                                        >
                                            Editar
                                        </a>

                                        <form
                                            method="post"
                                            action="{{ path('app_assunto_excluir', {id: assunto.codAs}) }}"
                                            class="d-inline"
                                        >
                                            <input
                                                type="hidden"
                                                name="_token"
                                                value="{{ csrf_token('delete' ~ assunto.codAs) }}"
                                            >

                                            <button
                                                type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Deseja realmente excluir este assunto?')"
                                            >
                                                Excluir
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
